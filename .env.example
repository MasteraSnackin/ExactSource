# Required at inference time. Set this through your shell or secret manager.
# Never commit a real value.
TINKER_API_KEY=

# Optional paid SFT pilot. The default acknowledgement is deliberately inert.
# A writable project ID and an explicit change to YES are both required together
# with `exactsource-sft train --execute`.
TINKER_PROJECT_ID=
EXACTSOURCE_ALLOW_PAID_TRAINING=NO
