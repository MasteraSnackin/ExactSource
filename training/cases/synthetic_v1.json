    {
      "id": "synthetic-category-summary-sheet-001",
      "split": "tune",
      "description": "Create a first-seen category summary with accumulated values.",
      "instruction_type": "Sheet-Level Manipulation",
      "instruction": "Create a Summary worksheet containing each category from Data once in first-seen order and its total Amount.",
      "answer_ranges": [{"sheet": "Summary", "range": "A1:B4"}],
      "data_position": "Data!A1:B6",
      "workbook": {"sheets": [{"name": "Data", "cells": {"A1": "Category", "B1": "Amount", "A2": "Core", "B2": 10, "A3": "Growth", "B3": 25, "A4": "Core", "B4": 15, "A5": "Income", "B5": 8, "A6": "Growth", "B6": 5}}]},
      "plan": {"route": "python", "summary": "Create totals by first-seen category.", "python_code": "def transform(wb):\n    source = wb[\"Data\"]\n    totals = {}\n    order = []\n    for row in range(2, source.max_row + 1):\n        category = source.cell(row, 1).value\n        amount = source.cell(row, 2).value\n        if category not in totals:\n            totals[category] = 0\n            order.append(category)\n        totals[category] += amount\n    output = wb.create_sheet(\"Summary\")\n    output.append([\"Category\", \"Total\"])\n    for category in order:\n        output.append([category, totals[category]])"},
      "expectations": {"cells": {"Summary!A1": "Category", "Summary!B1": "Total", "Summary!A2": "Core", "Summary!B2": 25, "Summary!A3": "Growth", "Summary!B3": 30, "Summary!A4": "Income", "Summary!B4": 8}, "calculated": {}, "preserved": {"Data!A4": "Core", "Data!B6": 5}}
    }
