      "plan": {"route": "python", "summary": "Create the approved-items worksheet.", "python_code": "def transform(wb):\n    source = wb[\"Data\"]\n    output = wb.create_sheet(\"Approved\")\n    output.append([\"Name\", \"Amount\"])\n    target_row = 2\n    for source_row in range(2, source.max_row + 1):\n        if source.cell(source_row, 3).value == \"Approved\":\n            output.cell(target_row, 1).value = source.cell(source_row, 1).value\n            output.cell(target_row, 2).value = source.cell(source_row, 2).value\n            target_row += 1"},
